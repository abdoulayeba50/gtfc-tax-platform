# ==========================================
# GTFC Tax Platform - Backend
# Variables d'environnement (exemple)
# Copier ce fichier en ".env" et renseigner les vraies valeurs
# ==========================================

# --- Serveur ---
NODE_ENV=development
# 0.0.0.0 = ecoute sur toutes les interfaces reseau (PC en localhost ET
# appareils du meme reseau local via l'IP du PC, ex: telephone en Wi-Fi).
# Mettre 127.0.0.1 pour restreindre au PC uniquement (rarement utile).
HOST=0.0.0.0
PORT=5000

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gtfc_tax_platform
DB_USER=postgres
DB_PASSWORD=postgres

# --- Authentification JWT (utilisé plus tard par le module Auth) ---
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1d

# --- CORS ---
# Une ou plusieurs origines separees par des virgules (sans espace autour
# des virgules n'est pas obligatoire, elles sont "trim"). Ajouter l'IP
# locale du PC pour tester depuis un telephone sur le meme Wi-Fi.
# Exemple complet PC + telephone :
CORS_ORIGIN=http://localhost:3000,http://192.168.1.8:3000
