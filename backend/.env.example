# ==========================================
# GTFC Tax Platform - Backend
# Variables d'environnement (exemple)
# Copier ce fichier en ".env" et renseigner les vraies valeurs
# ==========================================

# --- Serveur ---
NODE_ENV=development
PORT=5000

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gtfc_tax_platform
DB_USER=postgres
DB_PASSWORD=postgres

# --- Authentification JWT (utilisé plus tard par le module Auth) ---
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1d

# --- CORS ---
# Origine(s) autorisée(s) à consommer l'API (dashboard, mobile en dev, etc.)
CORS_ORIGIN=http://localhost:3000
